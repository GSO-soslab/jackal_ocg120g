<?xml version="1.0"?>
<launch>

  <!-- RVIZ config -->
  <node pkg="rviz" name="rviz_j2" type="rviz" required="true" 
        args="-d $(find ocg120g_remote)/rviz/demo1_J2.rviz"/>

  <!-- bluetooth joy -->
  <node pkg="joy" type="joy_node" name="joy_node" ns = "bluetooth_teleop">
        <param name = "deadzone" value = "0.1"/>
        <param name = "autorepeat_rate" value = "20"/>
        <param name = "dev" value = "/dev/input/js0"/>
  </node>

  <!-- Deccompress pointcloud for transportation -->
  <node name="pc_decompress" pkg="point_cloud_transport" type="republish" 
        args="draco  in:=/camera/depth/color/points 
              raw   out:=/camera/depth/color/points/decompressed" />

</launch>